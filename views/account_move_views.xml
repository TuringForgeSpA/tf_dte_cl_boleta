<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: views/account_move_views.xml -->
<odoo>

    <record id="view_move_form_tf_dte_cl_boleta" model="ir.ui.view">
        <field name="name">account.move.form.tf_dte_cl_boleta</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="tf_dte_cl.view_move_form_tf_dte_cl"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tf_dte_cl_is_dte']" position="after">
                <field name="tf_dte_cl_is_boleta" invisible="1"/>
                <field name="tf_dte_cl_company_environment" invisible="1"/>
            </xpath>
            <!-- Solo en certificación: caso del set de pruebas de boletas. -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="tf_dte_cl_boleta_set_case" readonly="state != 'draft'" placeholder="CASO-1"
                       invisible="not tf_dte_cl_is_boleta or tf_dte_cl_company_environment != 'certificacion'"/>
            </xpath>
            <!-- Las boletas no llevan referencias en esta versión; sus notas de crédito sí. -->
            <xpath expr="//page[@name='tf_dte_cl_references']" position="attributes">
                <attribute name="invisible">not tf_dte_cl_is_dte or tf_dte_cl_is_boleta</attribute>
            </xpath>
        </field>
    </record>

</odoo>
