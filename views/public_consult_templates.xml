<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: views/public_consult_templates.xml
     Página pública /boleta (controllers/main.py). HTML propio, sin depender del
     módulo website ni cargar recursos externos. -->
<odoo>

    <template id="public_consult" name="Consulta de boletas electrónicas">
        &lt;!DOCTYPE html&gt;
        <html lang="es">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Consulta de boletas electrónicas</title>
                <style>
                    body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: #f4f5f7;
                           color: #1f2328; margin: 0; padding: 24px 16px; }
                    main { max-width: 460px; margin: 0 auto; background: #fff; border: 1px solid #d8dbe0;
                           border-radius: 8px; padding: 24px; }
                    h1 { font-size: 1.25rem; margin: 0 0 4px; }
                    p.help { color: #57606a; font-size: .9rem; margin: 0 0 20px; }
                    label { display: block; font-size: .85rem; font-weight: 600; margin: 14px 0 4px; }
                    input, select { width: 100%; box-sizing: border-box; padding: 9px 10px; font-size: 1rem;
                                    border: 1px solid #c4c8cf; border-radius: 6px; }
                    button { margin-top: 20px; width: 100%; padding: 11px; font-size: 1rem; font-weight: 600;
                             color: #fff; background: #1f6feb; border: 0; border-radius: 6px; cursor: pointer; }
                    .error { background: #fff1f0; border: 1px solid #f5c2c0; color: #8a1c17; border-radius: 6px;
                             padding: 10px 12px; font-size: .9rem; margin-bottom: 8px; }
                    .radio { display: flex; gap: 16px; margin-top: 6px; font-weight: 400; }
                    .radio input { width: auto; }
                </style>
            </head>
            <body>
                <main>
                    <h1>Consulta de boletas electrónicas</h1>
                    <p class="help">Ingrese los datos tal como aparecen en su boleta.</p>
                    <div class="error" t-if="error" t-out="error"/>
                    <form method="post" action="/boleta" autocomplete="off">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <label for="emitter_rut">RUT del emisor</label>
                        <input id="emitter_rut" name="emitter_rut" required="required" t-att-value="emitter_rut"
                               placeholder="76086428-5"/>
                        <label for="doc_type">Tipo de documento</label>
                        <select id="doc_type" name="doc_type">
                            <option value="39" t-att-selected="doc_type != '41'">Boleta electrónica</option>
                            <option value="41" t-att-selected="doc_type == '41'">Boleta exenta electrónica</option>
                        </select>
                        <label for="folio">Folio</label>
                        <input id="folio" name="folio" required="required" inputmode="numeric" t-att-value="folio"/>
                        <label for="emission_date">Fecha de emisión</label>
                        <input id="emission_date" name="emission_date" type="date" required="required"
                               t-att-value="emission_date"/>
                        <label for="total">Monto total</label>
                        <input id="total" name="total" required="required" inputmode="numeric" t-att-value="total"
                               placeholder="29800"/>
                        <button type="submit">Ver boleta</button>
                    </form>
                </main>
            </body>
        </html>
    </template>

</odoo>
