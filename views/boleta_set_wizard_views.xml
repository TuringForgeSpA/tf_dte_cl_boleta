<?xml version="1.0" encoding="utf-8"?>
<!-- Ruta real: views/boleta_set_wizard_views.xml -->
<odoo>

    <record id="tf_dte_cl_boleta_set_wizard_view_form" model="ir.ui.view">
        <field name="name">tf_dte_cl_boleta.set.wizard.form</field>
        <field name="model">tf_dte_cl_boleta.set.wizard</field>
        <field name="arch" type="xml">
            <form string="Set de certificación de boletas">
                <div class="alert alert-info" role="alert" invisible="envelope_file">
                    Arma un único sobre con las boletas del set y el consumo de folios (RCOF), firmados.
                    Súbalos en el sitio de certificación del SII (opción Upload) y pida la revisión
                    del set informando el Track ID. El plazo del SII es de 24 horas desde que se
                    descargó el CAF.
                </div>
                <div class="alert alert-success" role="alert" invisible="not envelope_file">
                    Descargue los dos archivos, súbalos en el sitio de certificación del SII y anote el
                    Track ID del sobre de boletas para pedir la revisión.
                </div>
                <group>
                    <field name="move_ids" widget="many2many_tags" readonly="envelope_file"/>
                    <field name="sec_envio" readonly="envelope_file"/>
                    <field name="envelope_filename" invisible="1"/>
                    <field name="rcof_filename" invisible="1"/>
                    <field name="envelope_file" filename="envelope_filename" invisible="not envelope_file"/>
                    <field name="rcof_file" filename="rcof_filename" invisible="not envelope_file"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generar archivos" class="btn-primary"
                            invisible="envelope_file"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tf_dte_cl_boleta_set_wizard" model="ir.actions.act_window">
        <field name="name">Set de certificación de boletas</field>
        <field name="res_model">tf_dte_cl_boleta.set.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

</odoo>
